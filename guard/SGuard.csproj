<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageVersion>0.3.2</PackageVersion>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <PackageProjectUrl>https://selcukgural.github.io/SGuard/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/selcukgural/sguard</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>guard;is;throwIf;sguard;validation;dotnet;csharp;callbacks</PackageTags>
        <Description>SGuard is a lightweight guard library for .NET that offers boolean checks (Is.*) and throwing guards (ThrowIf.*), a unified SGuardCallback/GuardOutcome model, and exceptions that name the failing argument via CallerArgumentExpression. A passing guard doesn't allocate, and selectors are compiled once and cached. Targets net8.0/net9.0/net10.0.</Description>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <Title>SGuard</Title>
        <Authors>Selçuk Güral</Authors>
        <Company>Selçuk Güral</Company>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>See https://github.com/selcukgural/SGuard/blob/main/Changelog.md</PackageReleaseNotes>
        <PackageIcon>icon.png</PackageIcon>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <!-- Trimming and Native AOT. SGuard supports both; the APIs that can't (NullOrEmpty selectors) say so with
         RequiresUnreferencedCode and RequiresDynamicCode, so an app sees a warning where it calls them. The analyzers ship
         in a package whose version follows the installed SDK and so can't be pinned in packages.lock.json: the CI "aot"
         job runs them with -p:SGuardAotAnalysis=true and publishes SGuard.AotSmoke with Native AOT. -->
    <PropertyGroup Condition="'$(SGuardAotAnalysis)' == 'true'">
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <!-- What IsAotCompatible sets, so that trimming apps also trim SGuard in normal builds. -->
        <AssemblyMetadata Include="IsTrimmable" Value="True" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SGuard.Tests" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <None Update="LICENSE">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
    <!-- The analyzers and code fixes ship inside this package, so they need no package of their own. They are built with
         SGuard but not referenced by it. -->
    <ItemGroup>
        <ProjectReference Include="..\SGuard.Analyzers\SGuard.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\SGuard.Analyzers.CodeFixes\SGuard.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\SGuard.Analyzers\bin\$(Configuration)\netstandard2.0\SGuard.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="..\SGuard.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\SGuard.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\" />
        <None Include="icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
